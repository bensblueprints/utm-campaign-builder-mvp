# UTMcraft configuration — copy to .env and edit

# Port the web app listens on
PORT=5349

# Admin password for the dashboard (change this!)
ADMIN_PASSWORD=change-me

# SQLite database location
DB_PATH=./data/utmcraft.db

# Public base URL of this install — used for the tracked /r/ short links
# e.g. https://links.yourdomain.com
BASE_URL=
